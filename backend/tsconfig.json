{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext", // Añadido
    "target": "es2022",
    "types": ["node"], // Cambié esto a ["node"] para que reconozca 'process', '__dirname', etc.
    
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "verbatimModuleSyntax": true, // Si te sigue dando error de imports, ponlo en 'false'
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}